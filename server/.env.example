# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# Port Express listens on (Render provides this automatically in production)
PORT=5000

# Public base URL of the deployed app (used to build the OAuth callback URL)
# Local example:  http://localhost:5000
# Render example: https://ai-capsule.onrender.com
APP_BASE_URL=http://localhost:5000

# GitHub OAuth App credentials (https://github.com/settings/developers)
# Authorization callback URL must be: <APP_BASE_URL>/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Secret used to sign the application JWT (long random string)
JWT_SECRET=replace_with_a_long_random_string

# Path to the SQLite database file
DB_PATH=./db/capsule.db

# "true" in production so cookies are marked Secure (requires HTTPS)
COOKIE_SECURE=false
